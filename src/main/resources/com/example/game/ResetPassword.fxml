<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.game.ResetPasswordController"
            stylesheets="@style.css" prefWidth="600" prefHeight="400">
    <children>
        <Label text="Reset Password" layoutX="220" layoutY="40" styleClass="label-title"/>
        <Label text="Student ID:" layoutX="120" layoutY="120"/>
        <TextField fx:id="idField" layoutX="220" layoutY="115" prefWidth="220"/>

        <Label text="New Password:" layoutX="120" layoutY="170"/>
        <PasswordField fx:id="newPasswordField" layoutX="220" layoutY="165" prefWidth="220"/>

        <Label text="Confirm Password:" layoutX="120" layoutY="220"/>
        <PasswordField fx:id="confirmPasswordField" layoutX="220" layoutY="215" prefWidth="220"/>

        <Button text="Update Password" layoutX="220" layoutY="260" onAction="#resetPassword"/>
        <Button text="Back to Login" layoutX="360" layoutY="260" onAction="#goToLogin"/>

        <Label fx:id="messageLabel" layoutX="120" layoutY="300"/>
    </children>
</AnchorPane>
