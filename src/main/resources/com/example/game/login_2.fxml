<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.game.LoginController"
            prefWidth="700" prefHeight="450"
            style="-fx-background-color: linear-gradient(to bottom right, #243B55, #141E30);">

    <!-- ✨ Glass-like Login Card -->
    <VBox alignment="CENTER" spacing="15" prefWidth="380" prefHeight="360"
          layoutX="160" layoutY="50"
          style="-fx-background-color: rgba(255,255,255,0.12);
                 -fx-background-radius: 20;
                 -fx-padding: 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0.2, 2, 2);">

        <!-- Title -->
        <Label text="🔐 Student Login" textFill="white">
            <font>
                <Font name="System Bold" size="22"/>
            </font>
        </Label>

        <Separator style="-fx-background-color: #4FC3F7; -fx-padding: 0 10 0 10;"/>

        <!-- ID Field -->
        <TextField fx:id="idField" promptText="Enter your Student ID"
                   prefWidth="250"
                   style="-fx-background-radius: 10;
                          -fx-padding: 10;
                          -fx-background-color: rgba(255,255,255,0.8);"/>

        <!-- Password Field -->
        <PasswordField fx:id="passwordField" promptText="Enter your password"
                       prefWidth="250"
                       style="-fx-background-radius: 10;
                              -fx-padding: 10;
                              -fx-background-color: rgba(255,255,255,0.8);"/>

        <!-- Message Label -->
        <Label fx:id="messageLabel" textFill="#FFEE58">
            <font>
                <Font size="14"/>
            </font>
        </Label>

        <!-- Login Button -->
        <Button text="Login" onAction="#login"
                prefWidth="150" prefHeight="40"
                style="-fx-background-color: linear-gradient(to right, #00C853, #B2FF59);
                       -fx-background-radius: 15;
                       -fx-text-fill: #1B1B1B;
                       -fx-font-weight: bold;
                       -fx-font-size: 14;">
            <effect>
                <DropShadow color="#00C853" radius="10"/>
            </effect>
        </Button>

        <!-- Navigation Buttons -->
        <HBox alignment="CENTER" spacing="10">
            <Button text="Register" onAction="#goToRegister"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #4FC3F7;
                           -fx-font-size: 13;
                           -fx-underline: true;"/>
            <Button text="Forgot Password?" onAction="#goToResetPassword"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #E1BEE7;
                           -fx-font-size: 13;
                           -fx-underline: true;"/>
        </HBox>
    </VBox>
</AnchorPane>
