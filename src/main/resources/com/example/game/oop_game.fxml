<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.game.OopGameController"
            prefWidth="800" prefHeight="600" style="-fx-background-color: #1e1e2f;">
    <children>
        <VBox alignment="CENTER" layoutX="50" layoutY="30" prefWidth="700" spacing="15">
            <Label fx:id="titleLabel" style="-fx-font-size: 22; -fx-text-fill: #ffffff;" />

            <HBox alignment="CENTER" spacing="20">
                <Label fx:id="timerLabel" style="-fx-font-size: 18; -fx-text-fill: #ff4b5c;" text="⏳ Time: 05:00" />
                <Label fx:id="coinLabel" style="-fx-font-size: 18; -fx-text-fill: #ffd700;" text="💰 Coins: 0" />
            </HBox>

            <Label fx:id="puzzleLabel" style="-fx-font-size: 20; -fx-font-weight: bold;" wrapText="true" />

            <Label fx:id="feedbackLabel" style="-fx-font-size: 16;" />

            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="optionA" onAction="#handleOptionA" prefWidth="150" prefHeight="50"
                        style="-fx-background-color: #ffde59; -fx-font-size: 16;" text="Option A" />
                <Button fx:id="optionB" onAction="#handleOptionB" prefWidth="150" prefHeight="50"
                        style="-fx-background-color: #6c63ff; -fx-font-size: 16; -fx-text-fill: white;" text="Option B" />
                <Button fx:id="optionC" onAction="#handleOptionC" prefWidth="150" prefHeight="50"
                        style="-fx-background-color: #ff6f61; -fx-font-size: 16; -fx-text-fill: white;" text="Option C" />
            </HBox>

            <Label fx:id="gradeLabel" style="-fx-font-size: 18; -fx-text-fill: #00ffea;" />

            <Button fx:id="backButton" onAction="#handleBack" prefWidth="150" prefHeight="40"
                    style="-fx-background-color: #8884ff; -fx-font-size: 16; -fx-text-fill: white;" text="Back to Menu" />
        </VBox>
    </children>
</AnchorPane>
